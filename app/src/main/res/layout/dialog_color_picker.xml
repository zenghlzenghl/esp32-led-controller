<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <View
        android:id="@+id/viewColorPreviewDialog"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:background="#FF00FF"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/textRgbValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="RGB(255, 0, 255)"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="12dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Red (R)"
        android:textSize="13sp"
        android:textColor="#FF4444"
        android:layout_marginTop="8dp" />

    <SeekBar
        android:id="@+id/seekBarR"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="255"
        android:progress="255"
        android:progressTint="#FF4444" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Green (G)"
        android:textSize="13sp"
        android:textColor="#44FF44"
        android:layout_marginTop="8dp" />

    <SeekBar
        android:id="@+id/seekBarG"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="255"
        android:progress="0"
        android:progressTint="#44FF44" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Blue (B)"
        android:textSize="13sp"
        android:textColor="#4444FF"
        android:layout_marginTop="8dp" />

    <SeekBar
        android:id="@+id/seekBarB"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="255"
        android:progress="255"
        android:progressTint="#4444FF" />

</LinearLayout>